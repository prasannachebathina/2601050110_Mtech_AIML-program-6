      "source": [
        "import numpy as np\n",
        "\n",
        "A = np.array([[2, 1],\n",
        "              [1, 2]])\n",
        "\n",
        "# Eigen decomposition\n",
        "eigenvalues, eigenvectors = np.linalg.eig(A)\n",
        "\n",
        "print(\"Matrix:\")\n",
        "print(A)\n",
        "\n",
        "print(\"\\nEigenvalues:\")\n",
        "print(eigenvalues)\n",
        "\n",
        "print(\"\\nEigenvectors:\")\n",
        "print(eigenvectors)"
      ]
    }
  ]
